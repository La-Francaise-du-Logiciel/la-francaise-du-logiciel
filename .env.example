# Contact form relay: Scaleway Transactional Email (fr-par).
# Setup, in the Scaleway console:
#   1. Create a dedicated project for francaisedulogiciel.fr. Do not reuse
#      Tensel's project, TEM domain, IAM application, policy, or API key.
#   2. In that new project, Transactional Email → add and validate the domain
#      francaisedulogiciel.fr (SPF, DKIM, MX and DMARC records are given there).
#   3. Create a dedicated IAM application, policy, and API key with only the
#      TransactionalEmailEmailApiCreate permission, scoped only to this project.
#   4. Fill these values (locally in .env.local, and in the host's
#      environment in production).

# Secret from this website's dedicated IAM application (never Tensel's key)
SCW_SECRET_KEY=

# Dedicated website project that owns the validated domain (never Tensel's project)
SCW_PROJECT_ID=

# Region of the Transactional Email domain (default fr-par)
SCW_EMAIL_REGION=fr-par

# Sender: must be on the validated domain
CONTACT_FROM=formulaire@francaisedulogiciel.fr

# Recipient inbox
CONTACT_TO=contact@francaisedulogiciel.fr
