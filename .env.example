# Contact form relay. See docs/email.md for the full setup.
# Copy this file to .env.local for development, and set the same variables in
# the host's environment for production. Never commit real secrets.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Which adapter lib/email uses: scaleway-tem (default) or resend.
# Changing this value changes the provider; no site code changes.
MAIL_PROVIDER=scaleway-tem

# ---------------------------------------------------------------------------
# Addresses (provider-independent)
# ---------------------------------------------------------------------------
# Sender: must be on the domain validated for the selected provider.
# Scaleway TEM uses francaisedulogiciel.fr; Resend uses its dedicated
# mails.francaisedulogiciel.fr subdomain. lib/email validates this pairing.
CONTACT_FROM=formulaire@francaisedulogiciel.fr

# Recipient inbox
CONTACT_TO=contact@francaisedulogiciel.fr

# ---------------------------------------------------------------------------
# MAIL_PROVIDER=resend
# ---------------------------------------------------------------------------
# In the Resend dashboard:
#   1. Domains → add mails.francaisedulogiciel.fr and publish the SPF, DKIM
#      and DMARC records it gives you, then wait for the verified status.
#   2. API Keys → create a key for this website only, with Sending access
#      restricted to that subdomain. Do not reuse a key from another product.
#   3. Paste the key below (it is shown once).
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# MAIL_PROVIDER=scaleway-tem
# ---------------------------------------------------------------------------
# In the Scaleway console:
#   1. Create a dedicated project for francaisedulogiciel.fr. Do not reuse
#      Tensel's project, TEM domain, IAM application, policy, or API key.
#   2. In that new project, Transactional Email → add and validate the domain
#      francaisedulogiciel.fr (SPF and DKIM records are given there).
#   3. Create a dedicated IAM application, policy, and API key with only the
#      TransactionalEmailEmailApiCreate permission, scoped only to this project.

# Secret from this website's dedicated IAM application (never Tensel's key)
SCW_SECRET_KEY=

# Dedicated website project that owns the validated domain (never Tensel's project)
SCW_PROJECT_ID=

# Region of the Transactional Email domain (default fr-par)
SCW_EMAIL_REGION=fr-par
